# Atlas Kids Media - Environment Variables
# Copy this file to .env and fill in your real keys
# NEVER commit .env to Git — it is already in .gitignore

# === LLM Providers ===
GEMINI_API_KEY=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
RUNWAY_API_KEY=
FAL_API_KEY=

# === API Authentication (Auto-generated on first run) ===
# ATLAS_API_KEY=          # Admin key — full access
# ATLAS_READ_ONLY_KEY=    # Read-only key — view-only
# RATE_LIMIT_REQUESTS=60  # Requests per window
# RATE_LIMIT_WINDOW=60    # Window in seconds

# === Notifications ===
# SLACK_WEBHOOK_URL=
# EMAIL_ENABLED=false
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# ALERT_EMAIL=
