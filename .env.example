# Optional providers. Leave unset for the offline example and test suite.
GEMINI_API_KEY=
FAL_API_KEY=

# Optional loopback API. Generate values locally; never commit .env.
ATLAS_API_KEY=
ATLAS_READ_ONLY_KEY=
ATLAS_API_HOST=127.0.0.1
ATLAS_ENABLE_PUBLISHING=false
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW=60

# Optional notifications. Disabled when unset.
SLACK_WEBHOOK_URL=
NOTIFICATION_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
